# Azure DevOps pipeline for {{ service_name }}
# Generated by servicectl. Edit as needed.

trigger:
  branches:
    include:
      - main

pr:
  branches:
    include:
      - main

variables:
  imageName: '{{ registry }}/{{ service_name }}'
  tag: $(Build.BuildId)

stages:
  - stage: test
    displayName: lint + test
    jobs:
      - job: test
        displayName: test
        pool:
          vmImage: ubuntu-latest
        services:
          postgres:
            image: postgres:16-alpine
            env:
              POSTGRES_DB: {{ service_name }}_test
              POSTGRES_USER: postgres
              POSTGRES_PASSWORD: postgres
            ports:
              - 5432:5432
        variables:
          POSTGRES_HOST: localhost
          POSTGRES_PORT: 5432
          POSTGRES_DB: {{ service_name }}_test
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
        steps:
          - checkout: self
          - task: UsePythonVersion@0
            inputs:
              versionSpec: "3.12"
          - script: pip install -e ".[dev]"
            displayName: install
          - script: ruff check .
            displayName: lint
          - script: pytest
            displayName: test

  - stage: build
    displayName: build + scan
    dependsOn: test
    jobs:
      - job: build
        displayName: build
        pool:
          vmImage: ubuntu-latest
        steps:
          - checkout: self
          - script: docker build -t $(imageName):$(tag) .
            displayName: docker build
          - script: |
              docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                aquasec/trivy:latest image --exit-code 1 --severity HIGH,CRITICAL \
                $(imageName):$(tag)
            displayName: trivy scan

{% if ci_provider == 'azure-devops' %}
  - stage: publish
    displayName: publish
    dependsOn: [test, build]
    condition: and(succeeded(), eq(variables['Build.SourceBranch'], 'refs/heads/main'))
    jobs:
      - job: publish
        displayName: publish
        pool:
          vmImage: ubuntu-latest
        steps:
          - checkout: self
          - script: |
              docker tag $(imageName):$(tag) $(imageName):latest
              docker push $(imageName):$(tag)
              docker push $(imageName):latest
            displayName: push image
{% endif %}
