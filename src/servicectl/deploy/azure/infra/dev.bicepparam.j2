// Dev environment parameters — generated by servicectl.
// Deploy: az deployment group create --resource-group <rg> --template-file main.bicep --parameters dev.bicepparam
using './main.bicep'

param environment = 'dev'
param location = '{{ azure_region }}'
param serviceName = '{{ service_name }}'
param imageName = '{{ registry }}/{{ service_name }}:dev'
param appServicePlanSku = 'B1'
param postgresSku = 'B20ms'
param acrSku = 'Basic'

# Passwords belong in Key Vault, not in this file. Wire it up at deploy time
# with `--parameters postgresAdminPassword=$(az keyvault secret show ...)` or
# pull from a pipeline secret. See README for the recommended pattern.
param postgresAdminPassword = 'replace-me-with-a-real-secret-from-key-vault'
