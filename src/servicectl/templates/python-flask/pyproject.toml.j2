[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ service_name }}"
version = "0.1.0"
description = "{{ template_description }} service scaffolded by servicectl"
requires-python = ">=3.10"
dependencies = [
    "flask>=3.0",
    "psycopg[binary]>=3.1",
    "gunicorn>=21.2",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "pytest-cov>=4.1",
    "ruff>=0.3",
]

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
addopts = "--cov=app --cov-report=term-missing --cov-fail-under={{ coverage_threshold }}"
testpaths = ["tests"]

[tool.ruff]
line-length = 100
target-version = "py310"
