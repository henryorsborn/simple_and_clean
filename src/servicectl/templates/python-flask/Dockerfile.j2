# syntax=docker/dockerfile:1.6
FROM python:3.12-slim AS build
WORKDIR /app

RUN pip install --no-cache-dir build hatchling hatch-fancy-pypi-readme

COPY pyproject.toml ./
COPY src ./src
RUN pip wheel --no-cache-dir --wheel-dir /wheels .

FROM python:3.12-slim AS runtime
WORKDIR /app

COPY --from=build /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels {{ service_name }} \
    && rm -rf /wheels

USER nonroot
EXPOSE 3000
ENV PORT=3000 \
    PYTHONUNBUFFERED=1

CMD ["gunicorn", "--bind", "0.0.0.0:3000", "--workers", "2", "app:create_app()"]
