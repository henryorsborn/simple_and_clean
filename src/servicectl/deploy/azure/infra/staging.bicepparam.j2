// Staging environment parameters — generated by servicectl.
using './main.bicep'

param environment = 'staging'
param location = '{{ azure_region }}'
param serviceName = '{{ service_name }}'
param imageName = '{{ registry }}/{{ service_name }}:staging'
param appServicePlanSku = 'P1v3'
param postgresSku = 'B30ms'
param acrSku = 'Standard'

@secure()
param postgresAdminPassword = 'replace-me-with-a-real-secret-from-key-vault'
