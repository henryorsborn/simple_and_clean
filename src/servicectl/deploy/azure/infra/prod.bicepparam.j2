// Production environment parameters — generated by servicectl.
using './main.bicep'

param environment = 'prod'
param location = '{{ azure_region }}'
param serviceName = '{{ service_name }}'
param imageName = '{{ registry }}/{{ service_name }}:latest'
param appServicePlanSku = 'P2v3'
param postgresSku = 'B50ms'
param acrSku = 'Standard'

@secure()
param postgresAdminPassword = 'replace-me-with-a-real-secret-from-key-vault'
